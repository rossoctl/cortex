# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out
cover.out

# Go workspace files. Note `go.work` IS tracked despite this
# pattern — gitignore does not apply to already-tracked files, and that one is
# committed deliberately so every checkout gets the same module graph. This
# pattern stops *new* stray go.work files (and go.work.sum, which is generated).
go.work
go.work.sum

# Build artifacts and binaries
dist/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.bak
*.orig

# Local scratch / working notes (never committed)
.sketchpad/

# venv
venv
.venv

# Secrets and credentials
.env
.env.*
!.env.example
!.env.template
.env.local
*.key
*.pem
*.p12
*.jks
credentials.json
credentials.env
secrets.json
secrets.env
kubeconfig
*.kubeconfig

# Python
__pycache__/
*.pyc
.ruff_cache/
*.egg-info/
.pytest_cache/
.mypy_cache/

# Go build artifacts — local `go build` outputs in cmd/* dirs
# (binary name matches the package dir; trivially `git add`-ed by mistake).
#
# Spelled out per binary on purpose. A Go binary has no extension, so no glob
# can tell "the compiled output" from a source file or a package directory —
# `cmd/*/*` would ignore the source. One line per binary is the only
# pattern that is safe, so the list below is exhaustive for `cmd/` and for the
# two `scripts/` helpers further down. The `demos/*` mains are deliberately not
# listed. Keep adding to it.
cmd/agentop/agentop
cmd/cortex/cortex
cmd/cortex-envoy/cortex-envoy
cmd/cortex-cpex/cortex-cpex
cmd/cortex-praxis/cortex-praxis
# Built from the repo root rather than from inside the package dir, a binary lands
# here instead, so ignore those spellings too. Note `go build ./cmd/...` is NOT
# one of those commands: with more than one main package Go compiles and discards
# (`go help build`). What lands a binary here is a single-package build such as
# `go build ./cmd/cortex`, or `go build -o . ./cmd/...`.
# `authbridge-lite` appears here but has no cmd/ entry above: it is a build
# variant of cortex, not its own module. No build emits that filename —
# the lite variant is always written as cortex — so this entry is purely
# defensive, against someone passing `-o authbridge-lite` by hand.
#
# Leading slash is load-bearing now that the repo root IS the module root: a bare
# `agentop` has no separator, so git would match it at any depth — including the
# package directory `cmd/agentop`, silently ignoring new source files under it.
/agentop
/cortex
/cortex-envoy
/cortex-cpex
/authbridge-lite
/cortex-praxis

# MLflow local tracking store — created by `mlflow` runs in the working tree.
# Local experiment state, not project source.
mlflow.db
mlruns/

# Cortex writes its CA + keys under ~/.cortex. This covers the fallback location
# used when $HOME is unresolvable, and any explicit `--ca-dir ./cortex-ca`, so a
# private key can never be committed from a demo run inside a checkout.
cortex-ca/

# Local git worktrees (git worktree add .worktrees/<name>). Committing these
# gitlinks pins another branch's checkout into this tree, which is never wanted.
.worktrees/

# `go build ./...` inside either scripts/ helper drops its multi-MB
# binary beside the source, where it is easy to stage by accident — it was, once.
/scripts/profile-tags/profile-tags
/scripts/readme-demo/readme-demo
# ...and the repo-root spellings, for the same reason as the cmd/* ones above:
# `go build ./scripts/profile-tags` (or `-o .`) from the root lands it there.
# Anchored for the same reason as the binaries above: bare `profile-tags` would
# also match the package directory `scripts/profile-tags`.
/profile-tags
/readme-demo

# Output dir for `make agentop` / `make cortex`.
/bin/

# CPEX FFI libraries unpacked by scripts/fetch-cpex-ffi.sh.
.cpex-ffi/
