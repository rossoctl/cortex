# The gateway config of the end-to-end tests (tests/gateway.rs). The test
# replaces each {{NAME}}.
insecure_options:
  allow_unbounded_body: true
  allow_private_upstreams: true
  allow_private_endpoints: true

body_limits:
  max_request_bytes: 33554432
  max_response_bytes: null

listeners:
  - name: gateway
    address: "127.0.0.1:{{LISTEN}}"
    filter_chains: [main]

filter_chains:
  - name: main
    filters:
      - filter: cortex_attribution
        token_file: "{{TOKEN_FILE}}"
      - filter: cortex_observe
        token_file: "{{TOKEN_FILE}}"
        ingest: "127.0.0.1:{{INGEST}}"
{{ACCESS_LOG}}
      - filter: router
        routes:
          - path_prefix: "/"
            cluster: origin
      - filter: load_balancer
        clusters:
          - name: origin
            endpoints: ["127.0.0.1:{{ORIGIN}}"]
